generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  username     String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  purchaseInvoices PurchaseInvoice[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Item {
  id              String   @id @default(cuid())
  name            String
  barcode         String?  @unique
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  origin          String?
  costPrice       Float
  sellingPrice    Float
  quantityInStock Int      @default(0)
  createdAt       DateTime @default(now())

  purchaseInvoices  PurchaseInvoice[]
  salesInvoiceItems SalesInvoiceItem[]
}

model PurchaseInvoice {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Int
  unitCost    Float
  totalPaid   Float
  supplier    String?
  date        DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  createdAt DateTime @default(now())

  salesInvoices SalesInvoice[]

  @@index([phone])
}

model SalesInvoice {
  id          String    @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  /// What the customer paid: sum of line subtotals minus `discountAmount`.
  totalAmount Float
  date        DateTime  @default(now())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  /// Discount on the whole sale, in money (a percentage is converted at checkout).
  discountAmount Float  @default(0)
  /// Cash handed over and change given back. Null on deliveries and older sales.
  cashReceived   Float?
  changeGiven    Float?

  isDelivery      Boolean         @default(false)
  deliveryAddress String?
  deliveryStatus  DeliveryStatus?

  items   SalesInvoiceItem[]
  returns SalesReturn[]
}

model SalesInvoiceItem {
  id               String       @id @default(cuid())
  salesInvoiceId   String
  salesInvoice     SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  itemId           String
  item             Item         @relation(fields: [itemId], references: [id])
  quantity         Int
  unitPrice        Float
  unitCost         Float
  /// Discount on this line, in money.
  discountAmount   Float        @default(0)
  /// unitPrice × quantity − discountAmount.
  subtotal         Float
  /// Units already returned, so a line can't be refunded twice.
  returnedQuantity Int          @default(0)

  returnItems SalesReturnItem[]
}

/// Items brought back from a sale. The sale itself is never edited.
model SalesReturn {
  id             String       @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  date           DateTime     @default(now())
  /// Cash paid back to the customer.
  refundAmount   Float
  reason         String?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  items SalesReturnItem[]
}

model SalesReturnItem {
  id                 String           @id @default(cuid())
  salesReturnId      String
  salesReturn        SalesReturn      @relation(fields: [salesReturnId], references: [id])
  salesInvoiceItemId String
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id])
  quantity           Int
  refundAmount       Float
  /// Copied from the sale line so profit reverses at the original cost.
  unitCost           Float
}
